{
  "openapi": "3.1.0",
  "info": {
    "title": "IBN API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint for container monitoring",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/add_topology": {
      "post": {
        "summary": "Topology Endpoint",
        "description": "Add topology nodes to the system",
        "operationId": "topology_endpoint_api_add_topology_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "example": "All node creation requests have been sent."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/demo": {
      "get": {
        "summary": "Demo Endpoint",
        "description": "Run the DT Robot UseCase demo process",
        "operationId": "demo_endpoint_api_demo_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "example": "🎉 **DT Robot UseCase processing COMPLETED** 🎉"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/list": {
      "get": {
        "summary": "List Endpoint",
        "description": "List service_graph and network_function files from the service catalog",
        "operationId": "list_endpoint_api_list_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
